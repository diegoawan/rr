MainTab:CreateSection("Automation")

local autoMiniGameRunning = false
local autoClicksRunning = false
local autoSecretCodesRunning = false
local autoCashRunning = false
local autoPrestigeRunning = false
local autoSunResetRunning = false
local autoClassesRunning = false

MainTab:CreateToggle({
    Name = "Auto Mini Game",
    CurrentValue = false,
    Callback = function(Value)
        autoMiniGameRunning = Value

        if Value then
            task.spawn(function()
                while autoMiniGameRunning do
                    pcall(function()
                        local Character = LocalPlayer.Character
                        local Root = Character and Character:FindFirstChild("HumanoidRootPart")
                        local World = workspace:FindFirstChild("World")
                        local Obby = World and World:FindFirstChild("Obby")
                        local RewardObby = Obby and Obby:FindFirstChild("RewardObby")

                        if Root and RewardObby then
                            local OriginalCFrame = Root.CFrame
                            local ObbyCFrame

                            if RewardObby:IsA("BasePart") then
                                ObbyCFrame = RewardObby.CFrame
                            elseif RewardObby:IsA("Model") then
                                ObbyCFrame = RewardObby:GetPivot()
                            end

                            if ObbyCFrame then
                                Root.CFrame = ObbyCFrame + Vector3.new(0, 3, 0)
                                task.wait(1)
                                Root.CFrame = OriginalCFrame
                            end
                        end
                    end)

                    task.wait(60)
                end
            end)
        end
    end
})

